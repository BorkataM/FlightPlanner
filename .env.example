# ============================================================================
# SkyWave / FlightPlanner - single environment file for the whole stack.
# Copy this to .env and fill in real values. The .env file is gitignored.
# ============================================================================

# --- AI service (Python / FastAPI) - full async Postgres URL ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- .NET API - database (split fields) ---
DB_HOST=db.xxxxx.supabase.co
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# --- .NET API - secrets / integrations ---
JWT_KEY=base64-signing-key
OPENWEATHER_API_KEY=your-openweather-key
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# --- Password-reset emails (SMTP) ---
# Leave blank to log the reset link to the API console instead of sending mail.
# Gmail: use an App Password (https://myaccount.google.com/apppasswords), host smtp.gmail.com, port 587.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youraddress@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM=youraddress@gmail.com

# --- Local development only (running services WITHOUT Docker) ---
# Docker ignores these: compose sets AI_SERVICE_URL to http://ai-service:8000
# and bakes the VITE_* values into the client image at build time.
AI_SERVICE_URL=http://localhost:8000
VITE_API_URL=https://localhost:7236
VITE_AI_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
