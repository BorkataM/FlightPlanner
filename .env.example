# Copy to .env and fill in real values. The .env file is gitignored.

# --- AI service (Python) — full async Postgres URL ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- .NET API — Postgres connection (split fields) ---
DB_HOST=db.xxxxx.supabase.co
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# --- .NET API — secrets / integrations ---
JWT_KEY=base64-signing-key
OPENWEATHER_API_KEY=your-openweather-key
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# --- Password-reset emails (SMTP) ---
# Leave blank to log the reset link to the API console instead of sending mail.
# Gmail: use an App Password (https://myaccount.google.com/apppasswords), host smtp.gmail.com, port 587.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youraddress@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM=youraddress@gmail.com

# --- Production deploy (Caddy HTTPS) — only needed on the server ---
DOMAIN=skywave.duckdns.org
ACME_EMAIL=you@example.com
